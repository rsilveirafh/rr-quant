{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/", "destination": "/api/index" }],
  "crons": [{ "path": "/api/refresh", "schedule": "30 11 * * 1-5" }],
  "functions": {
    "api/refresh.py": {
      "maxDuration": 60,
      "excludeFiles": "{data/transcricoes/**,output/**,docs/**,.venv/**}"
    },
    "api/index.py": {
      "excludeFiles": "{data/transcricoes/**,output/**,docs/**,.venv/**}"
    }
  }
}
